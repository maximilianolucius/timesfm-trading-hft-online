#!/usr/bin/env python3
"""Entry-point CLI for TimesFM trading workflows."""
from __future__ import annotations

import json
import pathlib
import sys
from typing import Optional

import typer

ROOT = pathlib.Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from common.config import ProjectConfig, load_config
from common.data_io_csv import (
    build_sliding_windows,
    load_csv,
    split_train_validation,
    zscore_normalise,
)
from common.logging_utils import get_logger
from jobs.train import run_training
from jobs.backtest import run_backtest

app = typer.Typer(help="TimesFM fine-tuning toolkit")


@app.command()
def prep(config: pathlib.Path = typer.Option(..., exists=True, help="YAML configuration file")) -> None:
    """Validate CSV inputs and prepare tensors for training."""

    cfg = load_config(str(config))
    logger = get_logger("prep")

    df = load_csv(
        cfg.resolve_path(cfg.data.train_csv),
        frequency=cfg.data.frequency,
        timezone=cfg.data.timezone,
        limit=cfg.data.limit,
        resample=cfg.data.resample,
        expect_no_gaps=cfg.data.expect_no_gaps,
    )

    if cfg.data.normalize:
        df_norm, mean, std = zscore_normalise(df, cfg.task.features)
    else:
        df_norm, mean, std = df, df[cfg.task.features].mean(), df[cfg.task.features].std(ddof=0)

    if cfg.data.val_csv:
        df_val = load_csv(
            cfg.resolve_path(cfg.data.val_csv),
            frequency=cfg.data.frequency,
            timezone=cfg.data.timezone,
            limit=cfg.data.limit,
            resample=cfg.data.resample,
            expect_no_gaps=cfg.data.expect_no_gaps,
        )
    else:
        df_norm, df_val = split_train_validation(
            df_norm,
            validation_split=cfg.prep.validation_split,
            shuffle=cfg.prep.shuffle_before_split,
            seed=cfg.training.seed,
        )

    train_ds = build_sliding_windows(
        df_norm,
        cfg.task.context_len,
        cfg.task.horizon_len,
        cfg.task.features,
        cfg.task.target,
    )
    val_ds = build_sliding_windows(
        df_val,
        cfg.task.context_len,
        cfg.task.horizon_len,
        cfg.task.features,
        cfg.task.target,
    )

    workdir = cfg.resolve_path(cfg.training.checkpoint_dir)
    workdir.mkdir(parents=True, exist_ok=True)

    (workdir / f"{cfg.task.name}_train.npz").write_bytes(
        _pack_npz(train_ds.contexts, train_ds.targets, train_ds.timestamps)
    )
    (workdir / f"{cfg.task.name}_val.npz").write_bytes(
        _pack_npz(val_ds.contexts, val_ds.targets, val_ds.timestamps)
    )

    stats = {"mean": mean.tolist(), "std": std.tolist(), "features": cfg.task.features}
    (workdir / f"{cfg.task.name}_stats.json").write_text(json.dumps(stats, indent=2))

    logger.info("Preparation complete", extra={"train_samples": len(train_ds), "val_samples": len(val_ds)})


def _pack_npz(contexts, targets, timestamps) -> bytes:
    import io
    import numpy as np

    buffer = io.BytesIO()
    np.savez_compressed(buffer, contexts=contexts, targets=targets, timestamps=timestamps)
    return buffer.getvalue()


@app.command()
def train(config: pathlib.Path = typer.Option(..., exists=True)) -> None:
    cfg = load_config(str(config))
    run_training(cfg)


@app.command()
def backtest(config: pathlib.Path = typer.Option(..., exists=True)) -> None:
    cfg = load_config(str(config))
    run_backtest(cfg)


@app.command()
def serve(config: pathlib.Path = typer.Option(..., exists=True), host: Optional[str] = None, port: Optional[int] = None) -> None:
    cfg = load_config(str(config))
    from api.app import launch

    host = host or cfg.serve.host if cfg.serve else "127.0.0.1"
    port = port or cfg.serve.port if cfg.serve else 8000
    launch(cfg, host=host, port=port)


@app.command()
def trade(
    config: pathlib.Path = typer.Option(..., exists=True),
    dry_run: bool = typer.Option(False, help="Dry-run without sending MT5 orders"),
) -> None:
    cfg = load_config(str(config))
    from rt.ea_mt5 import run_trader

    run_trader(cfg, dry_run=dry_run)


if __name__ == "__main__":
    app()
